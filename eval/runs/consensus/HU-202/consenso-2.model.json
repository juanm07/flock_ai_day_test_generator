{
  "story_id": "HU-202",
  "title": "Exportación de movimientos de cuenta",
  "module": "Movimientos",
  "role": "cliente de home banking",
  "want": "exportar los movimientos de mi cuenta en un rango de fechas",
  "so_that": "conciliarlos con mi sistema contable",
  "feature_tags": [
    "dates",
    "export",
    "money",
    "ui"
  ],
  "acceptance_criteria": [
    {
      "id": "CA-1",
      "text": "Desde \"Movimientos\", el cliente selecciona una cuenta, un rango de fechas (desde/hasta) y un formato (CSV, XLSX o PDF) y toca \"Exportar\"."
    },
    {
      "id": "CA-2",
      "text": "El sistema genera el archivo rápidamente con los movimientos del período, incluyendo fecha, descripción, importe y saldo."
    },
    {
      "id": "CA-3",
      "text": "El archivo se descarga con el nombre `movimientos_<cuenta>_<desde>_<hasta>.<ext>`."
    },
    {
      "id": "CA-4",
      "text": "Si el rango no tiene movimientos, el sistema muestra un mensaje adecuado."
    }
  ],
  "parameters": [
    {
      "name": "cuenta",
      "description": "Cuenta del cliente cuyos movimientos se exportan; su moneda puede ser ARS o USD.",
      "kind": "enum",
      "ac_refs": [
        "CA-1",
        "CA-3"
      ],
      "choices": [
        {
          "name": "cuenta_ars",
          "description": "Cuenta en pesos (ARS).",
          "kind": "valid",
          "example": "Cuenta ARS 0012345678",
          "assumed": false
        },
        {
          "name": "cuenta_usd",
          "description": "Cuenta en dólares (USD).",
          "kind": "valid",
          "example": "Cuenta USD 0087654321",
          "assumed": false
        },
        {
          "name": "sin_seleccionar",
          "description": "No se selecciona ninguna cuenta antes de tocar Exportar.",
          "kind": "invalid",
          "example": "",
          "assumed": true
        }
      ],
      "bounds_relevant": false
    },
    {
